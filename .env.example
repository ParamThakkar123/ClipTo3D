# Copy to .env and edit. `docker compose` reads it automatically.
# .env is gitignored; this file is the documented shape, not a config to use.

# --- required ---------------------------------------------------------------

# Mints the first API key, once, in strict auth mode. Without it the API
# generates one per process and logs it, which does not survive a restart.
# In public mode it keeps working, so you can always mint an admin key.
#   python -c "import secrets; print('boot_' + secrets.token_urlsafe(32))"
CLIPTO3D_BOOTSTRAP_KEY=

# --- who can use it ---------------------------------------------------------

#   strict  you issue every key with the bootstrap secret. Private deployment.
#   public  anyone can mint their own key, rate-limited per address. This is
#           the mode for a self-serve site where visitors upload a video.
#   open    no keys, no auth. Localhost only.
CLIPTO3D_AUTH=strict

# public mode only. Self-service keys cannot issue further keys, so one
# visitor stays one caller; this caps how many identities one address can
# claim, which is what stops the per-caller quota being farmed. In-memory
# abuse friction, not an access control — it resets on restart.
CLIPTO3D_KEYS_PER_ADDRESS=5
CLIPTO3D_KEYS_WINDOW_SECONDS=86400

# Default lifetime of a share link, in seconds. 0 means it never expires.
# Per-link `ttl_seconds` on POST /jobs/<id>/share overrides this.
CLIPTO3D_SHARE_TTL_SECONDS=0

# Only needed for the `tls` profile. Must already point at this host.
CLIPTO3D_DOMAIN=

# --- exposure ---------------------------------------------------------------

# Where the API's port is published. Loopback by default so a compose up on a
# public VPS does not put an unproxied HTTP service on the internet. Behind
# Caddy this is correct as-is; set 0.0.0.0 only if something else fronts it.
CLIPTO3D_BIND=127.0.0.1

# Turn on ONLY with a trusted proxy in front — and DO turn it on when you run
# the tls profile, which provides one. Off, X-Forwarded-For is ignored
# everywhere (uvicorn's own proxy-header handling included, see
# docker/api-entrypoint.sh), because otherwise it is client-controlled and the
# rate limiter and per-address signup cap are bypassed by forging it.
#
# It is also what turns on HSTS: without a proxy telling the API the request
# arrived over TLS, it cannot know, and asserting HSTS over plain HTTP would
# strand the service.
CLIPTO3D_TRUST_PROXY=0

# Which peers may set X-Forwarded-For, when the above is on. Defaults to any,
# which is correct behind a proxy that terminates every connection; pin it to
# the proxy's address if something can reach the API directly as well.
CLIPTO3D_FORWARDED_ALLOW_IPS=*

# Comma-separated. Leave empty unless a front end is hosted off-origin — the
# viewer and capture pages are served by the API itself and need no CORS.
CLIPTO3D_CORS_ORIGINS=

# --- capacity ---------------------------------------------------------------

# Concurrent reconstructions per worker container. Set to the GPU count:
# reconstruction is GPU-bound, so oversubscribing slows every job down.
CLIPTO3D_WORKERS=1

# Narrow to your own hardware to cut the COLMAP build time a lot.
# 8.6 = RTX 30xx, 8.9 = RTX 40xx, 9.0 = H100.
TORCH_CUDA_ARCH_LIST=7.5;8.0;8.6;8.9;9.0

# ...-vits for a much smaller image; empty to mount a checkpoint cache instead.
BAKE_CHECKPOINTS=depth-anything-v2-vitl

CLIPTO3D_MAX_UPLOAD_MB=500
CLIPTO3D_QUOTA_ACTIVE=2
CLIPTO3D_QUOTA_TOTAL=50
CLIPTO3D_RATE_LIMIT=120

# --- retention --------------------------------------------------------------
# Quotas cap the job count per caller; these cap how long the bytes live,
# which is the axis that actually fills a disk. 0 disables either sweep.

CLIPTO3D_JOB_RETENTION_DAYS=30
CLIPTO3D_UPLOAD_RETENTION_HOURS=24

# --- object storage (optional) ----------------------------------------------
# With this set, artifacts are pushed to the bucket and the viewer is handed
# presigned URLs instead of streaming results through the API.

CLIPTO3D_STORAGE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

CLIPTO3D_LOG_LEVEL=INFO
